# Copy this file to .env and fill in real values.
# `npm start` / `npm run dev` load this via --env-file=.env (see package.json).

# --- Auth secrets ---------------------------------------------------------
# Any long random string works locally, e.g. `openssl rand -hex 32`.
JWT_SECRET=
REFRESH_SECRET=
RESET_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
RESET_TOKEN_EXPIRY=15m

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Postgres (used by Sequelize, src/sequelize/config/database.js) -------
PGHOST=localhost
PGPORT=5433
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# Full connection string, matches the PG* values above.
DATABASE_URL=postgres://PGUSER:PGPASSWORD@PGHOST:PGPORT/PGDATABASE

# --- Redis (BullMQ queues + rate limiter, src/utils/redisClient.js) --------
REDIS_URL=redis://localhost:6379

# --- OpenSearch (search index, src/opensearch) -----------------------------
OPENSEARCH_URL=http://localhost:9200

# --- Mail (password reset emails, src/utils/mailer.js) ---------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Rate limiting (src/middlewares/rateLimiter.js) ------------------------
# Per-user limit applied to every authenticated request in server.js.
RATE_LIMIT_USER_WINDOW_MS=1000
RATE_LIMIT_USER_MAX=5
# Per-IP limit applied to /v1/sign/signin and /v1/sign/signup in src/routes/auth.js.
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
