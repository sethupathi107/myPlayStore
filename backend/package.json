  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "reindex:apps": "node --env-file=.env src/opensearch/reindexApplications.js",
    "reset:index": "node --env-file=.env src/opensearch/resetIndex.js",
    "migrate": "node --env-file=.env src/sequelize/config/cli.js up",
    "migrate:down": "node --env-file=.env src/sequelize/config/cli.js down",
    "migrate:status": "node --env-file=.env src/sequelize/config/cli.js pending",
    "migrate:create": "node --env-file=.env src/sequelize/config/cli.js create --folder src/sequelize/config/migrations --name",
    "seed:categories": "node --env-file=.env scripts/seedCategories.js",
    "seed:apps": "node --env-file=.env scripts/seedApps.js",
    "seed:downloads": "node --env-file=.env scripts/seedDownloads.js"
  },
